.herness/
# the release-gate suite builds hermetic fixtures here (ledger, evidence, config, machine version
# files); they are per-run artefacts, never a source file
test/.release-gate-fixtures/
# the release-publish suite builds hermetic pack roots, ledgers, a throwaway "server" dir and one
# fake .tgz here; per-run artefacts, never a source file
test/.release-publish-fixtures/
# the machine-facts suite writes its facts/config/ledger fixtures here; per-run artefacts
test/.machine-facts-fixtures/
# the profile-guard suite builds throwaway DSH homes, a real .tgz and a ledger here
test/.profile-guard-fixtures/
# the publish-studio-files suite writes throwaway script fixtures here
test/.publish-studio-fixtures/
# scratch trees left by gated-release rehearsal (an evidence file, an older build kept for a
# hand-comparison); per-run artefacts, never a source file
test/.evidence-*/
test/.oldbuild-*/
